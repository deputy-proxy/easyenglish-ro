NODE_ENV=production
PORT=3100
HOST=0.0.0.0
OPENWA_SESSION_ID=easyenglish-openwa
OPENWA_SESSION_DIR=/home/USER/private/easyenglish-openwa/session
OPENWA_SESSION_KEY_DIR=/home/USER/private/easyenglish-openwa/keys
OPENWA_SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
OPENWA_PAIRING_USERNAME=operator
OPENWA_PAIRING_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
OPENWA_PUBLIC_BASE_URL=https://openwa-service.example.com
OPENWA_CHROME_EXECUTABLE=
OPENWA_CHROME_NO_SANDBOX=false
OPENWA_ALLOW_LIVE_TEST=false
OPENWA_PAIRING_ENABLED=false
OPENWA_SERVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SERVICE_TO_SERVICE_TOKEN

# Optional messaging gateway. Keep disabled until account, callback, and end-to-end checks pass.
OPENWA_MESSAGING_ENABLED=false
OPENWA_MESSAGING_CALLBACK_URL=https://your-easyenglish-host.example/webhooks/openwa
OPENWA_MESSAGING_CALLBACK_SECRET=
