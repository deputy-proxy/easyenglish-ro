APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The public web middleware fixes the website locale to Romanian.
# These defaults remain English for CLI and internal operations.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Keep log for local development. Use resend only after configuring a verified sender.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public Easy English website
EASYENGLISH_CONTACT_EMAIL=
DATA_RETENTION_ENABLED=false

# Stripe Checkout (use test-mode credentials outside production)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=false

# Meta Cloud API is reserved for contact-verification OTPs. OpenWA handles ordinary notifications.

# Meta Cloud API: keep disabled until the authentication template, webhook, and live OTP delivery are verified.
META_WHATSAPP_VERIFICATION_ENABLED=false
META_WHATSAPP_TRANSACTIONAL_ENABLED=false
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE_RO=ro
WHATSAPP_TEMPLATE_LANGUAGE_EN=en_US
WHATSAPP_TEMPLATE_CONTACT_VERIFICATION_LANGUAGE_RO=ro
WHATSAPP_TEMPLATE_CONTACT_VERIFICATION_LANGUAGE_EN=en
WHATSAPP_TEMPLATE_CONTACT_VERIFICATION=easyenglish_activation
# OpenWA transactional message catalogue keys (not Meta-approved templates).
WHATSAPP_TEMPLATE_PURCHASE_CONFIRMATION=easyenglish_purchase_confirmation
WHATSAPP_TEMPLATE_INTRO_BOOKING_CONFIRMATION=easyenglish_intro_booking_confirmation
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMATION=easyenglish_appointment_confirmation
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_24H=easyenglish_appointment_reminder_24h
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_1H=easyenglish_appointment_reminder_1h
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=easyenglish_booking_cancelled
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=easyenglish_booking_rescheduled
WHATSAPP_TEMPLATE_TEACHER_CANCELLATION=easyenglish_teacher_cancellation
WHATSAPP_TEMPLATE_BOOKING_NO_SHOW=easyenglish_booking_no_show
WHATSAPP_TEMPLATE_REFUND_SUCCEEDED=easyenglish_refund_succeeded
WHATSAPP_TEMPLATE_REFUND_FAILED=easyenglish_refund_failed
WHATSAPP_TEMPLATE_BUNDLE_EXPIRY_14D=easyenglish_bundle_expiry_14d
WHATSAPP_TEMPLATE_BUNDLE_EXPIRY_3D=easyenglish_bundle_expiry_3d

# Teacher-based availability and Google Calendar integration. Keep disabled until a teacher roster is provisioned and synced.
TEACHER_AVAILABILITY_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# OpenWA scheduled call events (disabled until rollout approval)
OPENWA_ENABLED=false
OPENWA_APPLY_TO_PAID_SESSIONS=false
OPENWA_ROLLOUT_STAGE=off
OPENWA_ROLLOUT_CUSTOMER_EMAILS=
OPENWA_BASE_URL=
OPENWA_SERVICE_TOKEN=
# Separate messaging capability flag; OPENWA_ENABLED continues to control scheduled call events.
OPENWA_MESSAGING_ENABLED=false
OPENWA_MESSAGING_TIMEOUT=20
OPENWA_MESSAGING_CALLBACK_SECRET=
OPENWA_MESSAGING_CALLBACK_URL=https://your-easyenglish-host.example/webhooks/openwa
OPENWA_CONNECT_TIMEOUT=5
OPENWA_TIMEOUT=30
OPENWA_MAX_ATTEMPTS=5
OPENWA_RETRY_DELAYS=60,300,900,3600,14400
OPENWA_MONITOR_STALE_EVENT_MINUTES=20
OPENWA_MONITOR_DELIVERY_FAILURE_WINDOW_MINUTES=30
OPENWA_MONITOR_QUEUE_BACKLOG_THRESHOLD=50
OPENWA_MONITOR_QUEUE_OLDEST_AGE_MINUTES=10
OPENWA_MONITOR_PROVIDER_ERROR_THRESHOLD=5
OPENWA_MONITOR_PROVIDER_ERROR_WINDOW_MINUTES=10

WHATSAPP_TEMPLATE_TEACHER_BOOKING_CONFIRMED=easyenglish_teacher_booking_confirmation
WHATSAPP_TEMPLATE_TEACHER_BOOKING_RESCHEDULED=easyenglish_teacher_booking_rescheduled
WHATSAPP_TEMPLATE_CUSTOMER_CALL_LINK_READY=easyenglish_call_link_ready
WHATSAPP_TEMPLATE_TEACHER_CALL_LINK_READY=easyenglish_teacher_call_link_ready
WHATSAPP_TEMPLATE_TEACHER_BOOKING_CANCELLED=easyenglish_teacher_booking_cancelled

# Official EasyEnglish support WhatsApp number in E.164 format.
EASYENGLISH_CONTACT_WHATSAPP=

EASYENGLISH_ADMIN_EMAIL=office@edventure.ro
