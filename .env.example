APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public Easy English website
EASYENGLISH_POLICY_VERSION=2026-10-25
EASYENGLISH_CONTACT_EMAIL=

# Stripe Checkout (use test-mode credentials outside production)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=false

# WhatsApp Cloud API. Keep disabled until Meta account setup, approved templates, and live delivery tests are complete.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE_RO=ro
WHATSAPP_TEMPLATE_LANGUAGE_EN=en_US
WHATSAPP_TEMPLATE_PURCHASE_CONFIRMATION=easyenglish_purchase_confirmation
WHATSAPP_TEMPLATE_INTRO_BOOKING_CONFIRMATION=easyenglish_intro_booking_confirmation
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMATION=easyenglish_appointment_confirmation
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_24H=easyenglish_appointment_reminder_24h
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_1H=easyenglish_appointment_reminder_1h
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=easyenglish_booking_cancelled
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=easyenglish_booking_rescheduled
WHATSAPP_TEMPLATE_TEACHER_CANCELLATION=easyenglish_teacher_cancellation
WHATSAPP_TEMPLATE_REFUND_SUCCEEDED=easyenglish_refund_succeeded
WHATSAPP_TEMPLATE_REFUND_FAILED=easyenglish_refund_failed
WHATSAPP_TEMPLATE_BUNDLE_EXPIRY_14D=easyenglish_bundle_expiry_14d
WHATSAPP_TEMPLATE_BUNDLE_EXPIRY_3D=easyenglish_bundle_expiry_3d
